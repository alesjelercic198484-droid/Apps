{
  "name": "slopromet-gps",
  "version": "1.0.0",
  "private": true,
  "description": "SloPromet GPS — Slovenske prometne kamere v živo, avto GPS merilnik hitrosti, razmere na cestah ter poročanje o policiji, nesrečah in zastojih v realnem času.",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development NODE_NO_WARNINGS=1 tsx server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json --noEmit",
    "start": "NODE_ENV=production NODE_NO_WARNINGS=1 tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
